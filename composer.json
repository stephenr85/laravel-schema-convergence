{
    "name": "rushing/laravel-schema-convergence",
    "description": "Convergent migration guards: a published `create_*` migration that creates the table when it is absent, adds the columns it is missing, and refuses — writing nothing — when a column already exists with an incompatible shape. Replaces the bare `Schema::hasTable($t) → return` guard, whose success report is a lie whenever another package won the filename race with a different shape.",
    "keywords": ["laravel", "migrations", "schema", "convergence", "idempotent", "publishing"],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephenr85@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\SchemaConvergence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\SchemaConvergence\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "pint": "@php -d memory_limit=512M vendor/bin/pint",
        "test": "@php vendor/bin/phpunit"
    }
}
